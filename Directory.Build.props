<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>

    <Authors>Tom Longhurst</Authors>
    <Copyright>Copyright (c) Tom Longhurst</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thomhurst/Relayer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thomhurst/Relayer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>messaging;outbox;kafka;servicebus;sqs;rabbitmq;opentelemetry</PackageTags>
  </PropertyGroup>
</Project>
