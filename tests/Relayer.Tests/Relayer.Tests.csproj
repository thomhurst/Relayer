<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- Background GC can charge unused allocation-context bytes to the measuring thread
         (dotnet/runtime#134724). Keep exact allocation assertions and parallel test execution. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Update="servicebus-config.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Testcontainers.ServiceBus" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relayer\Relayer.csproj" />
    <ProjectReference Include="..\..\src\Relayer.HealthChecks\Relayer.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Relayer.Kafka\Relayer.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Relayer.AzureServiceBus\Relayer.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Relayer.AmazonSqs\Relayer.AmazonSqs.csproj" />
    <ProjectReference Include="..\..\src\Relayer.RabbitMQ\Relayer.RabbitMQ.csproj" />
    <!-- In-repo consumers must reference the generator explicitly; the NuGet package bundles it. -->
    <ProjectReference Include="..\..\src\Relayer.SourceGenerators\Relayer.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Shared\ConcurrentReceiveFixture.cs" Link="Fixtures\ConcurrentReceiveFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../tests/Shared/SendDurationCapture.cs" Link="Fixtures/SendDurationCapture.cs" />
  </ItemGroup>
</Project>
