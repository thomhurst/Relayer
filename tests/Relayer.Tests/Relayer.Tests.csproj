<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Prefer the local runtime-async opt-out attribute over copies visible through friend assemblies. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Relayer.TestContracts.Orders/Relayer.TestContracts.Orders.csproj" />
    <ProjectReference Include="../Relayer.TestContracts.Billing/Relayer.TestContracts.Billing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="servicebus-config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The SDK's messaging ActivitySource is opt-in. Set it at process startup, never mutate a global switch in a test. -->
    <RuntimeHostConfigurationOption Include="Azure.Experimental.EnableActivitySource" Value="true" />
    <PackageReference Include="Testcontainers.ServiceBus" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relayer\Relayer.csproj" />
    <ProjectReference Include="..\..\src\Relayer.HealthChecks\Relayer.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Relayer.AzureServiceBus.HealthChecks\Relayer.AzureServiceBus.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Relayer.Testing\Relayer.Testing.csproj" />
    <ProjectReference Include="..\..\src\Relayer.Kafka\Relayer.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Relayer.AzureServiceBus\Relayer.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Relayer.AmazonSqs\Relayer.AmazonSqs.csproj" />
    <ProjectReference Include="../../src/Relayer.AmazonSqs.HealthChecks/Relayer.AmazonSqs.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Relayer.RabbitMQ\Relayer.RabbitMQ.csproj" />
    <ProjectReference Include="../../src/Relayer.RabbitMQ.HealthChecks/Relayer.RabbitMQ.HealthChecks.csproj" />
    <!-- In-repo consumers must reference the generator explicitly; the NuGet package bundles it. -->
    <ProjectReference Include="..\..\src\Relayer.SourceGenerators\Relayer.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Shared/RuntimeAsyncMethodGenerationAttribute.cs" Link="Fixtures/RuntimeAsyncMethodGenerationAttribute.cs" />
    <Compile Include="../../tests/Shared/PooledBuilderCompletionFixture.cs" Link="Fixtures/PooledBuilderCompletionFixture.cs" />
    <Compile Include="..\..\tests\Shared\ConcurrentReceiveFixture.cs" Link="Fixtures\ConcurrentReceiveFixture.cs" />
    <Compile Include="../../benchmarks/Relayer.Benchmarks/RegressionGate/PendingReadBarrier.cs" Link="Fixtures/PendingReadBarrier.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../tools/FrozenAllocationReader/RuntimeIdentityScope.cs" Link="Fixtures/RuntimeIdentityScope.cs" />
    <Compile Include="../../tools/FrozenAllocationReader/NativeEngineTail.cs" Link="Fixtures/NativeEngineTail.cs" />
    <Compile Include="../../tools/FrozenAllocationReader/AllocationScope.cs" Link="Fixtures/AllocationScope.cs" />
    <Compile Include="../../tools/FrozenAllocationReader/AllocationGroups.cs" Link="Fixtures/AllocationGroups.cs" />
    <Compile Include="../../tools/FrozenDriverProbe/WorkerReadChannel.cs" Link="Fixtures/WorkerReadChannel.cs" />
    <Compile Include="../../tools/FrozenFixtureProbe/SourceAllocations.cs" Link="Fixtures/SourceAllocations.cs" />
    <Compile Include="../../tools/FrozenFixtureProbe/InvocationAllocations.cs" Link="Fixtures/InvocationAllocations.cs" />
    <Compile Include="../../tests/Shared/SendDurationCapture.cs" Link="Fixtures/SendDurationCapture.cs" />
  </ItemGroup>
</Project>
