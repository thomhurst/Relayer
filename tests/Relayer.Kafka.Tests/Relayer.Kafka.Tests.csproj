<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Background GC can charge unused allocation-context bytes to this thread's allocation counter
         (dotnet/runtime#134724). Use blocking GC so strict allocation tests measure actual allocations.
         This changes only the test host; broker and test concurrency remain enabled. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Testcontainers.Kafka" />
    <PackageReference Include="Testcontainers.Redpanda" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Relayer.Kafka/Relayer.Kafka.csproj" />
    <ProjectReference Include="../../src/Relayer.Kafka.SchemaRegistry/Relayer.Kafka.SchemaRegistry.csproj" />
    <ProjectReference Include="../../src/Relayer.Kafka.HealthChecks/Relayer.Kafka.HealthChecks.csproj" />
    <ProjectReference Include="../../src/Relayer.Testing/Relayer.Testing.csproj" />
    <ProjectReference Include="../../src/Relayer.SourceGenerators/Relayer.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../tests/Shared/SendDurationCapture.cs" Link="Fixtures/SendDurationCapture.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/BoundedTransportPoolAssertions.cs" Link="Fixtures/BoundedTransportPoolAssertions.cs" />
  </ItemGroup>
</Project>
