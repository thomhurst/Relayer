<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <!-- Each assembly compiles its own internal RuntimeAsyncMethodGenerationAttribute; InternalsVisibleTo makes the copies overlap. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- .NET 10 includes GitHub SourceLink support in the SDK. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RuntimeAsyncMethodGenerationAttribute.cs" Link="Shared/RuntimeAsyncMethodGenerationAttribute.cs" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../assets/package-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
