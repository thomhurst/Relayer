<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Modern .NET messaging: wraps native broker clients and adds outbox, resiliency, telemetry and testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <!-- Ship the source generator inside the Relayer package (docs/decisions.md D4). -->
  <ItemGroup>
    <ProjectReference Include="..\Relayer.SourceGenerators\Relayer.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PackAnalyzer="true"
                      PackAnalyzerNotices="true" />
    <!-- Keep IDE-only Workspaces dependencies out of the compiler's generator assembly. -->
    <ProjectReference Include="..\Relayer.CodeFixes\Relayer.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      PackAnalyzer="true" />
  </ItemGroup>

  <!-- Collect framework-independent files once in the outer pack, including when packing without a build. -->
  <Target Name="AddAnalyzerPackageFiles" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('PackAnalyzer', 'true'))"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <_AnalyzerWithNotices Include="@(_AnalyzerAssembly->WithMetadataValue('PackAnalyzerNotices', 'true'))" />
      <None Include="@(_AnalyzerAssembly);
                     @(_AnalyzerWithNotices->'%(RootDir)%(Directory)System.Text.Json.SourceGeneration.LICENSE.txt');
                     @(_AnalyzerWithNotices->'%(RootDir)%(Directory)System.Text.Json.SourceGeneration.NOTICES.txt')"
            Pack="true" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Relayer.Tests" />
    <InternalsVisibleTo Include="Relayer.Kafka" />
    <InternalsVisibleTo Include="Relayer.AmazonSqs" />
    <InternalsVisibleTo Include="Relayer.GooglePubSub" />
    <InternalsVisibleTo Include="Relayer.Nats" />
    <InternalsVisibleTo Include="Relayer.Kafka.Tests" />
    <InternalsVisibleTo Include="Relayer.AzureServiceBus" />
    <InternalsVisibleTo Include="Relayer.RabbitMQ" />
    <InternalsVisibleTo Include="Relayer.Benchmarks" />
    <InternalsVisibleTo Include="Relayer.Outbox.PostgreSql.Tests" />
    <InternalsVisibleTo Include="Relayer.Outbox.MySql" />
    <InternalsVisibleTo Include="Relayer.Outbox.MySql.Tests" />
    <InternalsVisibleTo Include="Relayer.Outbox.PostgreSql" />
    <InternalsVisibleTo Include="Relayer.Outbox.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Relayer.Outbox.PostgreSql.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Relayer.Outbox.SqlServer" />
    <InternalsVisibleTo Include="Relayer.Outbox.SqlServer.Tests" />
    <InternalsVisibleTo Include="Relayer.Sagas" />
    <InternalsVisibleTo Include="Relayer.Testing" />
    <InternalsVisibleTo Include="Relayer.Testing.Tests" />
  </ItemGroup>

</Project>
