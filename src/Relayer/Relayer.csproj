<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Modern .NET messaging: wraps native broker clients and adds outbox, resiliency, telemetry and testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <!-- Ship the source generator inside the Relayer package (docs/decisions.md D4). -->
  <ItemGroup>
    <ProjectReference Include="..\Relayer.SourceGenerators\Relayer.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <!-- Keep IDE-only Workspaces dependencies out of the compiler's generator assembly. -->
    <ProjectReference Include="..\Relayer.CodeFixes\Relayer.CodeFixes.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\Relayer.CodeFixes\bin\$(Configuration)\netstandard2.0\Relayer.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Relayer.SourceGenerators\bin\$(Configuration)\netstandard2.0\Relayer.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="..\Relayer.SourceGenerators\bin\$(Configuration)\netstandard2.0\System.Text.Json.SourceGeneration.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Relayer.SourceGenerators\bin\$(Configuration)\netstandard2.0\System.Text.Json.SourceGeneration.LICENSE.txt;..\Relayer.SourceGenerators\bin\$(Configuration)\netstandard2.0\System.Text.Json.SourceGeneration.NOTICES.txt"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Relayer.Tests" />
    <InternalsVisibleTo Include="Relayer.Benchmarks" />
    <InternalsVisibleTo Include="Relayer.Outbox.PostgreSql.Tests" />
    <InternalsVisibleTo Include="Relayer.Outbox.MySql" />
    <InternalsVisibleTo Include="Relayer.Outbox.MySql.Tests" />
    <InternalsVisibleTo Include="Relayer.Outbox.PostgreSql" />
    <InternalsVisibleTo Include="Relayer.Outbox.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Relayer.Outbox.SqlServer" />
    <InternalsVisibleTo Include="Relayer.Testing" />
  </ItemGroup>

</Project>
