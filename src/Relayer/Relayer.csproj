<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Modern .NET messaging: wraps native broker clients and adds outbox, resiliency, telemetry and testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- Ship the source generator inside the Relayer package (docs/decisions.md D4). -->
  <ItemGroup>
    <ProjectReference Include="..\Relayer.SourceGenerators\Relayer.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <None Include="..\Relayer.SourceGenerators\bin\$(Configuration)\netstandard2.0\Relayer.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Relayer.Tests" />
    <InternalsVisibleTo Include="Relayer.Testing" />
  </ItemGroup>

</Project>
