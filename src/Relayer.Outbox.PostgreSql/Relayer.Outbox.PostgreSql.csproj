<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PostgreSQL ADO.NET outbox and shared inbox storage for Relayer. Consumer inbox transactions are provided by Relayer.Outbox.PostgreSql.EntityFrameworkCore.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/OutboxTransactionLifecycle.cs" Link="OutboxTransactionLifecycle.cs" />
    <PackageReference Include="Npgsql" />
    <EmbeddedResource Include="Schema.sql" />
    <EmbeddedResource Include="InsertSequenceMigration.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Relayer.Outbox.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Relayer.Outbox.PostgreSql.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Relayer.Outbox.PostgreSql.Tests" />
    <InternalsVisibleTo Include="Relayer.AotSmoke" />
    <InternalsVisibleTo Include="Relayer.Benchmarks" />
    <ProjectReference Include="..\Relayer\Relayer.csproj" />
  </ItemGroup>

</Project>
