<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The builder comparison can target net11.0 without retargeting generator/tool dependencies. -->
    <TargetFramework Condition="'$(RelayerBenchmarkTargetFramework)' != ''">$(RelayerBenchmarkTargetFramework)</TargetFramework>
    <!-- Prefer the local runtime-async opt-out attribute over copies visible through friend assemblies. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <DefineConstants>$(DefineConstants);RELAYER_FOCUSED_SPI</DefineConstants>
    <!-- BenchmarkDotNet generates code that trips some analyzers. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Relayer.GooglePubSub/Relayer.GooglePubSub.csproj" />
    <ProjectReference Include="../../src/Relayer.Nats/Relayer.Nats.csproj" />
    <ProjectReference Include="../../src/Relayer.Outbox.SqlServer/Relayer.Outbox.SqlServer.csproj" />
    <ProjectReference Include="../../src/Relayer.Sagas.EntityFrameworkCore/Relayer.Sagas.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Relayer.AzureServiceBus\Relayer.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Relayer.AmazonSqs\Relayer.AmazonSqs.csproj" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relayer.Outbox.PostgreSql\Relayer.Outbox.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Relayer.Outbox.MySql/Relayer.Outbox.MySql.csproj" />
    <ProjectReference Include="..\..\src\Relayer\Relayer.csproj" />
    <ProjectReference Include="..\..\src\Relayer.Outbox.PostgreSql.EntityFrameworkCore\Relayer.Outbox.PostgreSql.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/Relayer.Kafka/Relayer.Kafka.csproj" />
    <ProjectReference Include="../../src/Relayer.RabbitMQ/Relayer.RabbitMQ.csproj" />
    <ProjectReference Include="../../src/Relayer.Kafka.SchemaRegistry/Relayer.Kafka.SchemaRegistry.csproj" />
    <ProjectReference Include="../../src/Relayer.Serialization.Protobuf/Relayer.Serialization.Protobuf.csproj" />
    <ProjectReference Include="../../src/Relayer.Kafka.Serialization.Avro/Relayer.Kafka.Serialization.Avro.csproj" />
    <ProjectReference Include="..\..\src\Relayer.SourceGenerators\Relayer.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Shared/RuntimeAsyncMethodGenerationAttribute.cs" Link="Fixtures/RuntimeAsyncMethodGenerationAttribute.cs" />
    <Compile Include="../../tests/Shared/PooledBuilderCompletionFixture.cs" Link="Fixtures/PooledBuilderCompletionFixture.cs" />
    <Compile Include="..\..\tests\Shared\ConcurrentReceiveFixture.cs" Link="Fixtures\ConcurrentReceiveFixture.cs" />
    <Compile Include="../../tests/Shared/AvroFixture.cs" Link="Fixtures/AvroFixture.cs" />
    <Compile Include="../../tests/Shared/SendTracingCompletionFixture.cs" Link="Fixtures/SendTracingCompletionFixture.cs" />
  </ItemGroup>

</Project>
