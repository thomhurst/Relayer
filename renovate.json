{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "platformAutomerge": false,
  "draftPR": true,
  "packageRules": [
    {
      "description": "Keep the .NET 10 Microsoft.Extensions entries on v10; the separate .NET 11 entries already use v11.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchPackageNames": ["Microsoft.Extensions.*"],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "Workflow dotnet-version inputs install supported target runtimes; global.json owns SDK upgrades.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["dotnet-sdk"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Allocation diagnostics and frozen controls keep the runner image used by their historical baselines; change it only with deliberate re-baselining.",
      "matchDatasources": [
        "github-runners"
      ],
      "matchFileNames": [
        ".github/workflows/frozen-*.yml",
        ".github/workflows/sequence-allocation-control.yml",
        ".github/workflows/concurrent-allocation-owners.yml"
      ],
      "enabled": false
    },
    {
      "description": "Dependency updates use the repository's draft review lifecycle, overriding inherited automerge rules.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false,
      "platformAutomerge": false,
      "draftPR": true
    }
  ]
}
