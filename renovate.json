{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "platformAutomerge": false,
  "draftPR": true,
  "packageRules": [
    {
      "description": "Keep the .NET 10 Microsoft.Extensions entries on v10; the separate .NET 11 entries already use v11.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchPackageNames": ["Microsoft.Extensions.*"],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "Workflow dotnet-version inputs install supported target runtimes; global.json owns SDK upgrades.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["dotnet-sdk"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the .NET 10 entries of these framework-specific packages on 10.x. The .NET 11 entries already use 11.x.",
      "matchFileNames": ["Directory.Packages.props"],
      "matchPackageNames": ["Microsoft.Extensions.*", "Microsoft.AspNetCore.TestHost", "System.Security.Cryptography.Pkcs", "Microsoft.EntityFrameworkCore.Relational", "Npgsql", "Npgsql.EntityFrameworkCore.PostgreSQL"],
      "matchCurrentValue": "/^10\\./",
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "Dependency updates use the repository's draft review lifecycle, overriding inherited automerge rules.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false,
      "platformAutomerge": false,
      "draftPR": true
    }
  ]
}
